{
  "version": 2,
  "buildCommand": "next build",
  "devCommand": "next dev",
  "framework": "nextjs",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.5.2",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*\\.php)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 